{
  "name": "nexo-estudio",
  "private": true,
  "version": "14.0.0",
  "packageManager": "pnpm@11.25.0",
  "description": "Nexo Estudio — Academic Intelligence Foundation",
  "scripts": {
    "dev": "node tools/static-server.cjs",
    "supabase:prepare": "node tools/prepare-supabase.cjs",
    "build": "node tools/build.cjs",
    "test": "node tools/run-tests.cjs",
    "test:e2e": "node tools/e2e-test.cjs && node tools/profile-test.cjs && node tools/planner-e2e.cjs && node tools/cloud-e2e.cjs",
    "test:perf": "node tools/perf-audit.cjs",
    "test:a11y": "node tools/accessibility-test.cjs",
    "test:all": "node tests/run-all.cjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.95.3",
    "gsap": "3.15.0",
    "howler": "2.2.4",
    "phaser": "4.2.1",
    "posthog-js": "1.335.0",
    "ts-fsrs": "5.4.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.14",
    "playwright": "1.63.0"
  }
}
